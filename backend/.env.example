# ================================================================
# ParkEase Backend — Environment Configuration Template
# ================================================================

# Application Settings
APP_NAME="ParkEase"
ENVIRONMENT="production" # Options: development, staging, production
LOG_LEVEL="info"
SECRET_KEY="generate_strong_random_32byte_string_for_production_security"

# Server Host & Binding
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS='["https://your-production-web-app.vercel.app","http://localhost:5173"]'

# Database Settings (Production PostgreSQL URI format)
DATABASE_URL="postgresql://parkease_user:secure_password@postgres_host:5432/parkease_db"
POSTGRES_USER="parkease_user"
POSTGRES_PASSWORD="secure_password"
POSTGRES_SERVER="postgres_host"
POSTGRES_PORT=5432
POSTGRES_DB="parkease_db"

# JWT Security
JWT_SECRET_KEY="generate_strong_jwt_secret_key_for_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# Payment Gateway Configuration
PAYMENT_PROVIDER="SANDBOX" # Options: RAZORPAY, STRIPE, SANDBOX
RAZORPAY_KEY_ID="rzp_live_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
