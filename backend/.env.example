# ================================================================
# ParkEase Backend — Environment Configuration Template
# ================================================================

# Application Settings
APP_NAME="ParkEase"
ENVIRONMENT="production" # Options: development, staging, production
LOG_LEVEL="info"
SECRET_KEY="generate_strong_random_32byte_string_for_production_security"

# Server Host & Binding
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS='["https://your-production-web-app.vercel.app","http://localhost:5173"]'

# Database Settings (Neon PostgreSQL / standard PostgreSQL URI format)
# Note: Neon handles both postgresql:// and postgres:// schemas with sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_neon_password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
POSTGRES_USER="neondb_owner"
POSTGRES_PASSWORD="your_neon_password"
POSTGRES_SERVER="ep-xyz-pooler.ap-southeast-1.aws.neon.tech"
POSTGRES_PORT=5432
POSTGRES_DB="neondb"

# JWT Security
JWT_SECRET_KEY="generate_strong_jwt_secret_key_for_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# Payment Gateway Configuration
PAYMENT_PROVIDER="SANDBOX" # Options: RAZORPAY, STRIPE, SANDBOX
RAZORPAY_KEY_ID="rzp_live_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Real SMTP / Email Dispatch (Gmail Example)
# Supported Host Aliases: SMTP_HOST or MAIL_SERVER
SMTP_HOST="smtp.gmail.com"
# Supported Port Aliases: SMTP_PORT or MAIL_PORT (587 for STARTTLS)
SMTP_PORT=587
# Supported User Aliases: SMTP_USER or SMTP_USERNAME or MAIL_USERNAME
SMTP_USER="your_gmail_address@gmail.com"
# Supported Password Aliases: SMTP_PASSWORD or SMTP_PASS or MAIL_PASSWORD
# Note: For Gmail, use a 16-character Google App Password (not your personal account password)
SMTP_PASSWORD="abcd efgh ijkl mnop"
# Supported From-Email Aliases: EMAILS_FROM_EMAIL or SMTP_FROM_EMAIL or MAIL_FROM
EMAILS_FROM_EMAIL="noreply@parkease.com"
# Supported From-Name Aliases: EMAILS_FROM_NAME or SMTP_FROM_NAME or MAIL_FROM_NAME
EMAILS_FROM_NAME="ParkEase"
# Supported TLS Aliases: SMTP_TLS or SMTP_USE_TLS or MAIL_USE_TLS
SMTP_TLS=true
