# ParkEase Centralized Environment Variables Template
# Copy this file to .env and replace placeholder values for local development.

# Application Configuration
APP_NAME=ParkEase
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# Server Network Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8081","exp://192.168.1.100:8081"]

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL Database Configuration
POSTGRES_USER=parkease_user
POSTGRES_PASSWORD=parkease_secure_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=parkease_db

DATABASE_URL=postgresql://parkease_user:parkease_secure_password@localhost:5432/parkease_db
# For local SQLite development override:
# DATABASE_URL=sqlite:///./parkease_dev.db

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Web Application (apps/web)
VITE_APP_NAME=ParkEase
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Mobile Application (apps/mobile)
EXPO_PUBLIC_APP_NAME=ParkEase
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000/api/v1
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
