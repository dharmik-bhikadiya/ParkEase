# ================================================================
# ParkEase — Production Monorepo Environment Template
# NEVER COMMIT ACTUAL SECRETS OR .env FILES TO GIT REPOSITORY
# ================================================================

# Application Core
APP_NAME="ParkEase"
ENVIRONMENT="production"
LOG_LEVEL="info"
SECRET_KEY="generate_strong_32byte_random_string_here"

# Server Host & Binding
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS='["https://your-production-web-app.vercel.app"]'

# Database Configuration (Neon PostgreSQL / standard PostgreSQL URI)
DATABASE_URL="postgresql://neondb_owner:your_neon_password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
POSTGRES_USER="neondb_owner"
POSTGRES_PASSWORD="your_neon_password"
POSTGRES_SERVER="ep-xyz-pooler.ap-southeast-1.aws.neon.tech"
POSTGRES_PORT=5432
POSTGRES_DB="neondb"

# JWT Security
JWT_SECRET_KEY="generate_strong_jwt_secret_key_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Authentication OAuth 2.0
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Payment Gateway Configuration
PAYMENT_PROVIDER="SANDBOX" # Options: RAZORPAY, STRIPE, SANDBOX
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"

# Web Client Environment Variables
VITE_APP_NAME="ParkEase"
VITE_API_BASE_URL="https://your-backend-api.onrender.com/api/v1"
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Mobile Client Environment Variables
EXPO_PUBLIC_APP_NAME="ParkEase"
EXPO_PUBLIC_API_BASE_URL="https://your-backend-api.onrender.com/api/v1"
EXPO_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
