# ================================================================
# ParkEase — Complete Environment Configuration Template
# PRODUCTION & DEVELOPMENT ENVIRONMENT KEYS
# ================================================================

# Application Core
APP_NAME="ParkEase"
ENVIRONMENT="development"
LOG_LEVEL="info"
SECRET_KEY="super_secret_parkease_key_change_in_production_32bytes"

# Server Host & Port
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL / SQLite fallback for dev)
POSTGRES_USER="parkease_user"
POSTGRES_PASSWORD="parkease_secure_password"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="parkease_db"
DATABASE_URL="postgresql://parkease_user:parkease_secure_password@localhost:5432/parkease_db"

# JWT Security
JWT_SECRET_KEY="parkease_jwt_secret_key_change_me_in_production_12345"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Authentication OAuth 2.0
GOOGLE_CLIENT_ID=""

# Payment Gateway Configuration (Optional - Falls back to WALLET/SANDBOX)
PAYMENT_PROVIDER="SANDBOX" # Options: RAZORPAY, STRIPE, SANDBOX
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
